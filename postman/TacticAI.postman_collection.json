            "pm.test('Estado ok', () => pm.expect(pm.response.json().estado).to.equal('ok'));"
          ]}}],
          "request": {
            "method": "GET",
            "url": "http://localhost:4000/health"
          }
        }
      ]
    }
  ]
}
