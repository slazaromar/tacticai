    {
      "name": "Autenticación",
      "item": [
        {
          "name": "POST iniciar sesión (admin)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Tiene tokenAcceso', () => pm.expect(pm.response.json().tokenAcceso).to.be.a('string'));",
            "pm.test('Usuario tiene rol', () => pm.expect(pm.response.json().usuario.rol).to.be.oneOf(['admin','entrenador','analista']));",
            "const r = pm.response.json();",
            "pm.collectionVariables.set('token_acceso', r.tokenAcceso);",
            "pm.collectionVariables.set('token_refresco', r.tokenRefresco);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"correo\":\"admin@tacticai.com\",\"contrasena\":\"Admin1234!\"}" },
            "url": "{{base_url}}/autenticacion/iniciar-sesion"
          }
        },
        {
          "name": "POST iniciar sesión (credenciales erróneas)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 401', () => pm.response.to.have.status(401));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"correo\":\"admin@tacticai.com\",\"contrasena\":\"WRONG\"}" },
            "url": "{{base_url}}/autenticacion/iniciar-sesion"
          }
        },
        {
          "name": "POST refrescar token",
          "event": [{ "listen": "test", "script": { "exec": [
