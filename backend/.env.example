# ── Base de datos ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tacticai
DB_USER=tacticai_user
DB_PASSWORD=your_db_password_here

# ── Redis ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ── Autenticación JWT ──────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_to_another_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# ── Motor de recomendación ─────────────────────────────
URL_MOTOR=http://localhost:8000
CLAVE_MOTOR=internal_api_key_change_in_production

# ── Servidor ───────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# ── Correo (para invitaciones de analistas) ────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@club.com
SMTP_PASS=your_smtp_password_here
SMTP_FROM="TacticAI <noreply@club.com>"
APP_URL=http://localhost:3000
