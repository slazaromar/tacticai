# ── Aplicación ─────────────────────────────────────────
DEPURAR=false

# ── Seguridad ──────────────────────────────────────────
INTERNAL_API_KEY=change_this_to_a_long_random_string

# ── Servicios ──────────────────────────────────────────
DATABASE_URL=postgresql://tacticai_user:your_db_password@localhost:5432/tacticai
REDIS_URL=redis://:your_redis_password@localhost:6379/0
BACKEND_URL=http://localhost:4000

# ── Pesos del algoritmo (deben sumar 1.0) ─────────────
PESO_FORMA=0.40
PESO_ROL=0.30
PESO_GENERAL=0.20
PESO_CONTRATO=0.10

# ── Banquillo ──────────────────────────────────────────
TAMANO_BANQUILLO=7
